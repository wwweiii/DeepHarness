{
  "name": "deepharness",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:vendor": "bun run packages/vendor-capabilities/src/cli.ts audit",
    "audit:review-draft": "bun run packages/vendor-capabilities/src/cli.ts audit --write-review-draft",
    "test:contract": "bun test tests/contract",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "typescript": "6.0.3"
  }
}
