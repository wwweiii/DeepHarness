# Anthropic-compatible provider endpoint. Include /v1 when required by the provider.
ANTHROPIC_BASE_URL=https://api.example.com/v1

# Keep the real token only in .env; never commit it.
ANTHROPIC_AUTH_TOKEN=replace-with-provider-token

# Provider model ID used by Claude Code.
ANTHROPIC_MODEL=provider-primary-model-id

# Gateway authentication is disabled only for the local/test Compose profile.
# Enable it for a private deployment and provide a long password (12+ chars).
AUTH_ENABLED=1
AUTH_COOKIE_SECURE=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-private-password
METRICS_TOKEN=replace-with-a-private-metrics-token

# Select exactly one non-Anthropic provider. Leave all selectors empty for Anthropic.
CLAUDE_CODE_USE_BEDROCK=
CLAUDE_CODE_USE_VERTEX=
CLAUDE_CODE_USE_FOUNDRY=
CLAUDE_CODE_USE_OPENAI=
CLAUDE_CODE_USE_GEMINI=
CLAUDE_CODE_USE_GROK=

# Provider-specific values are passed only to the Worker/Agent process.
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
ANTHROPIC_BEDROCK_BASE_URL=
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_BASE_URL=
ANTHROPIC_FOUNDRY_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
GROK_API_KEY=
XAI_API_KEY=
GROK_BASE_URL=
GROK_MODEL=

# Manual provider smoke profiles allow exactly one short ACP prompt and enforce this timeout.
PROVIDER_SMOKE_TIMEOUT_MS=120000
PROVIDER_SMOKE_MAX_THINKING_TOKENS=1024
